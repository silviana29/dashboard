# Salin nilai berikut ke .env aplikasi. Jangan commit API key produksi.
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_EXPIRY_PERIOD=60
SUBSCRIPTION_REMINDER_DAYS=7

# APP_URL harus berupa domain publik HTTPS agar callback Duitku dapat diterima.
# Contoh production: APP_URL=https://mwork.example.com
